#!/bin/bash
# lidawake — keep Mac awake with lid closed; blank display on close.
# Usage: lidawake on | off | status
set -euo pipefail

VERSION="1.2.0"

# Resolve install dir (symlink-safe)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
# 监视进程的启动/停止/状态都在 lid-display-watch.sh 里（与 Alfred 共用同一份逻辑）
WATCH="$ROOT/lid-display-watch.sh"

usage() {
  cat <<USAGE
lidawake ${VERSION} — 合盖不休眠（灭屏，系统保持醒着）

用法:
  lidawake on       开启：disablesleep + 合盖灭屏监视
  lidawake off      关闭：恢复合盖休眠，停监视
  lidawake status   查看状态（也可：lidawake）
  lidawake help     帮助

用完请 off。依赖 macOS pmset；on/off 需要管理员权限。
USAGE
}

# Prefer passwordless sudo when already configured; else macOS admin dialog.
pmset_disablesleep() {
  local val="$1"
  if sudo -n /usr/bin/pmset -a disablesleep "$val" 2>/dev/null; then
    return 0
  fi
  osascript -e "do shell script \"/usr/bin/pmset -a disablesleep ${val}\" with administrator privileges" >/dev/null
}

cmd_on() {
  if [ ! -x "$WATCH" ]; then
    echo "找不到灭屏监视脚本: ${WATCH}" >&2
    exit 1
  fi
  if ! pmset_disablesleep 1; then
    echo "开启失败（可能取消了密码）" >&2
    exit 1
  fi
  "$WATCH" stop
  if ! "$WATCH" launch; then
    echo "监视程序没起来（SleepDisabled 已开，合盖不会自动灭屏）；请重试 lidawake on，或 lidawake off" >&2
    exit 1
  fi
  echo "已开启：合盖不休眠"
}

cmd_off() {
  if pmset_disablesleep 0; then
    if [ -x "$WATCH" ]; then "$WATCH" stop; fi
    echo "已关闭：恢复合盖会休眠"
  else
    # 没关成功就保留监视，免得 SleepDisabled=1 时合盖屏幕不灭
    echo "关闭失败（可能取消了密码）；监视保留，请重试 lidawake off" >&2
    exit 1
  fi
}

cmd_status() {
  local line last
  if [ ! -x "$WATCH" ]; then
    echo "状态未知：找不到监视脚本 ${WATCH}"
    return 0
  fi
  line=$("$WATCH" status)
  echo "${line}"
  case "$line" in
    已开，但监视没在跑*)
      last=$(tail -n 1 "$HOME/Library/Logs/lidawake.log" 2>/dev/null || true)
      if [ -n "$last" ]; then echo "日志最后一行: ${last}"; fi
      ;;
  esac
}

main() {
  local cmd="${1:-status}"
  case "$cmd" in
    on) cmd_on ;;
    off) cmd_off ;;
    status|"") cmd_status ;;
    -h|--help|help) usage ;;
    -v|--version) echo "lidawake $VERSION" ;;
    *)
      echo "未知参数: ${cmd}" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
